{
  "manifest_version": 3,
  "name": "Storyfied",
  "version": "0.1.0",
  "description": "Reads the ticket you're viewing on any board and uses Gemini to produce an AI-ready, editable summary.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Storyfy this ticket"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"]
}
